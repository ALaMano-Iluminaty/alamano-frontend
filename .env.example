# Copiar a .env antes de `npm run dev`.

# URL base REST del Core. Relativa: la atiende el proxy de Vite. Ver vite.config.ts.
VITE_API_GATEWAY_URL=/api

# WebSocket STOMP del Realtime Gateway. Relativa: la atiende el proxy de Vite.
VITE_WS_GATEWAY_URL=/ws

# true = datos y eventos simulados en el navegador, sin backend.
VITE_USE_MOCKS=false

# Base de Auth (login, registro, refresh). Va fuera de /api: nginx manda /api/* al Core.
VITE_AUTH_URL=/auth

# Servicios activos del usuario del token, para resincronizar al reconectar (cliente
# y vendedor). Vacía = desactivado: dejarla así hasta que el Core esté desplegado.
# Valor esperado: /services/active (relativa a VITE_API_GATEWAY_URL, o sea
# GET /api/services/active). Responde 200 con un arreglo de ServiceResponse
# ([] si no hay) y 401 sin token.
VITE_ACTIVE_SERVICES_PATH=
